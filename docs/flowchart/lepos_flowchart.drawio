.0" width="980.0" height="44.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="exhibition-en" name="Exhibition 2024 (EN)"><mxGraphModel dx="1000" dy="1950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;LEPOS system flowchart — graduation exhibition version (Dec 2024)&lt;/b&gt;" style="text;align=left;verticalAlign=middle;fontSize=16;whiteSpace=wrap;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10.0" y="8.0" width="980.0" height="32.0" as="geometry"/></mxCell><mxCell id="lane1" value="Offline — data collection and model building (notebooks/)" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fillColor=#EEEEEE;swimlaneFillColor=#FFFFFF;strokeColor=#999999;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10.0" y="50.0" width="980.0" height="1070.0" as="geometry"/></mxCell><mxCell id="lane2" value="Online — user session (Streamlit app at the exhibition)" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;fillColor=#EEEEEE;swimlaneFillColor=#FFFFFF;strokeColor=#999999;html=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10.0" y="1140.0" width="980.0" height="740.0" as="geometry"/></mxCell><mxCell id="T1" value="Start" style="shape=mxgraph.flowchart.terminator;fillColor=#F5F5F5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane1"><mxGeometry x="90.0" y="57.0" width="140.0" height="40.0" as="geometry"/></mxCell><mxCell id="D1" value="Naver News articles&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;68 KOSPI firms · 2019–2023&lt;/span&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;white